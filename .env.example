# Copy to .env and fill in. Never commit .env.

# --- Local storage -----------------------------------------------------------
# Where raw feed captures and processed data are written (relative to repo root
# or absolute). Default: data/local (gitignored).
RDP_DATA_DIR=data/local
# Short name for this machine, used in output filenames so captures from
# several collectors can be merged (e.g. "pi", "vps"). Defaults to hostname.
RDP_HOST_TAG=

# --- Network Rail Open Data (publicdatafeeds.networkrail.co.uk) -------------
NR_USERNAME=
NR_PASSWORD=
NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
NR_STOMP_PORT=61618
# Unique, stable id for the durable subscription (e.g. "<username>-pi").
NR_CLIENT_ID=

# --- Rail Data Marketplace (raildata.org.uk), Kafka products ----------------
# Copy each value from the product's Pub/Sub tab. Each product has its own
# consumer group; do not share a group between machines.
RDM_BOOTSTRAP=
RDM_TRUST_TOPIC=
RDM_TRUST_USERNAME=
RDM_TRUST_PASSWORD=
RDM_TRUST_GROUP=
RDM_DARWIN_TOPIC=
RDM_DARWIN_USERNAME=
RDM_DARWIN_PASSWORD=
RDM_DARWIN_GROUP=

# --- Realtime Trains API (data.rtt.io) ----------------------------------------
# Long-life refresh token from api-portal.rtt.io. Personal, non-commercial use;
# never share it or commit it. Used only for small validation spot-checks.
RTT_REFRESH_TOKEN=

# --- Monitoring (optional) ---------------------------------------------------
# A URL that `rdp health` requests when all feeds are fresh (e.g. a
# dead-man's-switch service of your choice). Leave blank to disable.
HEALTHCHECK_URL=
